{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "melina/client",
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": [
            "bun-types"
        ]
    },
    "include": [
        "**/*",
        "server.ts"
    ]
}