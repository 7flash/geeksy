# Geeksy Environment Variables
# Copy to .env and fill in your values
# DO NOT commit .env to git

# ─── LLM API Keys (at least one required) ───
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=

# ─── Telegram (optional) ───
# TELEGRAM_APP_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_PHONE=

# ─── Server ───
BUN_PORT=3737

# ─── Paths (optional, defaults to cwd) ───
# GEEKSY_HOME=~/.geeksy
# GEEKSY_DB_PATH=~/.geeksy/geeksy.db
# GEEKSY_APP_ROOT=/path/to/geeksy
